# Clé API v1 Warcraft Logs (https://www.warcraftlogs.com/profile, section "Web API")
WCL_API_KEY=
# Clé API Anthropic (https://console.anthropic.com > Settings > API Keys)
ANTHROPIC_API_KEY=
# Modèle Claude utilisé pour l'analyse
ANTHROPIC_MODEL=claude-sonnet-5
# Optionnel : budget local de requêtes WCL par heure (défaut 3600)
WCL_HOURLY_BUDGET=
